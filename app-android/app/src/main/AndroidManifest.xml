<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber si hay internet para pasar a lo guardado (12.a); Android la concede sin preguntar. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- «Cercanos» de la hoja de filtros (9); se pide al aplicar. Con las dos la persona elige precisa o aproximada. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 6.a · «Abrir mi correo» solo se muestra si hay una app de correo: desde Android 11 hay que declarar la consulta. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
    </queries>

    <!-- Sin copias de seguridad: la sesión (JWT) se guarda en DataStore y no debe copiarse a otro equipo.
         allowBackup cubre Android 9–11 (por eso no hace falta fullBackupContent);
         dataExtractionRules, Android 12 y posteriores. -->
    <application
        android:name=".ExploraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExploraCity"
        tools:ignore="DataExtractionRules">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- WorkManager (cola de envío) se inicia desde ExploraApplication con su fábrica de workers: se quita el
             inicializador automático de androidx.startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 19 · La app de cámara escribe aquí la foto que se va a tomar (con un permiso de un solo uso sobre ese
             archivo): ExploraCity no necesita el permiso de cámara. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- singleTask: un enlace del correo con la app abierta llega a la misma instancia (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Los enlaces del correo (6.b y «Cambiar correo»): exploracity://enlace/restablecer y /confirmar-correo. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="exploracity" />
                <data android:host="enlace" />
                <data android:path="/restablecer" />
                <data android:path="/confirmar-correo" />
            </intent-filter>
        </activity>
    </application>

</manifest>
