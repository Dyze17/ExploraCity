# Copia este archivo como .env, que está fuera de git, y completa los valores.
# Lo leen `docker compose` y `./gradlew run`. En Cloud Run, estos valores son secretos del servicio.
#
# Ningún valor puede llevar «$»: docker compose lo toma como el comienzo de una variable y lo cambia por otra cosa
# (ya pasó con DATABASE_PASSWORD). Si una clave generada trae «$», genera otra.

# Base de datos de docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5432/exploracity
DATABASE_USER=exploracity
DATABASE_PASSWORD=

# Clave para firmar los tokens: al menos 32 caracteres aleatorios (por ejemplo, `openssl rand -base64 48`).
JWT_SECRET=

# Correos de las cuentas de moderador, separados por comas.
MODERATOR_EMAILS=

# Correo (SendGrid). Sin la clave, los correos no salen: quedan en un buzón de desarrollo.
SENDGRID_API_KEY=
# Remitente verificado en SendGrid; obligatorio con la clave.
MAIL_FROM=
MAIL_FROM_NAME=
# true solo en desarrollo: abre /v1/dev para leer el buzón desde los botones de prueba de la app. Nunca en Cloud Run.
DEV_MAILBOX=
# Dónde abren los enlaces del correo. Vacío: exploracity://enlace, hasta tener el dominio verificado.
APP_LINK_BASE_URL=

# Fotos (Cloudinary): las tres juntas. Sin ellas, las fotos van a la carpeta MEDIA_DIR (por omisión, api-ktor/media).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_DIR=
# Comienzo de las direcciones de esa carpeta. Vacío: http://localhost:8080, que también sirve en el teléfono con
# `adb reverse`. Si la app usa la IP del equipo (API_BASE_URL), pon esa misma.
PUBLIC_BASE_URL=

# Sugerencia de categoría (OpenRouter). Sin la clave, la sugerencia sale de palabras clave.
OPENROUTER_API_KEY=
# Vacío: deepseek/deepseek-chat (ADR-11).
OPENROUTER_MODEL=
